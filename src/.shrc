# !/bin/sh

alias sudo="sudo "
alias ls='ls --color=auto'
alias la="ls -la"
alias grep='grep --color=auto'
alias open="xdg-open"
alias g="git"
alias v="vagrant"
alias d="docker"
alias dc="docker compose"
alias di="docker images | sed -e '1d' | sort -h -r"

# git repository
alias gwl="git worktree list"

git-worktree-clone(){
  url=$1
  project=${url#*:}
  project=${project%.git}

  repos=$HOME/Repositories
  default_branch=$(git ls-remote --symref $url HEAD \
    | awk '/^ref:/ { sub("refs/heads/", "", $2); print $2 }')

  mkdir -p $repos/$project
  git clone $url $repos/$project/$default_branch
}
alias gwc="git-worktree-clone"

git-worktree-add(){
  branch="$1"
  wt="wt-${branch##*/}"

  git worktree add -b $branch "../$wt"
}
alias gwa="git-worktree-add"

git-worktree-remove(){
  target="$1"

  if [[ "$target" == wt-* ]]; then
    wt="$target"
  else
    wt="wt-${target##*/}"
  fi

  git worktree remove "../$wt"
}
alias gwr="git-worktree-remove"

select-repository(){
  repos=$HOME/Repositories
  project="$(find $repos -maxdepth 2 -type d -printf '%P\n' \
    | sed '/^$/d' \
    | sort -fr \
    | fzf)"

  if [ -z $project ]; then
    cd $repos
    return
  fi
  default_branch=$(ls $repos/$project | grep -v 'wt-' -m 1)
  cd $repos/$project/$default_branch
}
alias sd="select-repository"

re-login(){
  exec $SHELL -l
}
alias lo="re-login"

history-grep(){
  if [ $# = 0 ]; then
    history 10
  else
    history | grep "$@" | fzf | awk '{$1=""; print substr($0,2)}' | bash
  fi
}
alias h="history-grep"

case $OSTYPE in
  linux-gnu)
    alias upd="apt update && apt list --upgradable"
    alias upg="apt upgrade"
    alias ins="apt install"
  ;;
  *)
  ;;
esac
