# !/bin/sh

alias sudo="sudo "
alias ls='ls --color=auto'
alias la="ls -la"
alias grep='grep --color=auto'
alias open="xdg-open"
alias g="git"
alias v="vagrant"
alias d="docker"
alias dc="docker compose"
alias di="docker images | sed -e '1d' | sort -h -r"

select-repository(){
  repos=$HOME/Repositories
  dir="$(find $repos -maxdepth 2 -type d -printf '%P\n' \
    | sed '/^$/d' \
    | sort -fr \
    | fzf)"

  cd $repos/$dir
}
alias sd="select-repository"

re-login(){
  exec $SHELL -l
}
alias lo="re-login"

history-grep(){
  if [ $# = 0 ]; then
    history 10
  else
    history | grep "$@" | fzf | awk '{$1=""; print substr($0,2)}' | bash
  fi
}
alias h="history-grep"

case $OSTYPE in
  linux-gnu)
    alias upd="apt update && apt list --upgradable"
    alias upg="apt upgrade"
    alias ins="apt install"
  ;;
  *)
  ;;
esac
